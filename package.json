{
  "name": "oucloud",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/generate-sitemap.ts && tsx scripts/prerender.ts && tsx scripts/validate-seo.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tools:validate": "tsx scripts/validate-tools.ts",
    "seo:validate": "tsx scripts/validate-seo.ts",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "check": "pnpm typecheck && pnpm test && pnpm tools:validate",
    "ci": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "onlyBuiltDependencies": [
    "esbuild"
  ]
}
